# Required: MongoDB (connection string; DB is opened but unused in current routes)
MONGO_URL=mongodb://localhost:27017
DB_NAME=whiteboard

# Required for /api/chat
OPENROUTER_API_KEY=

# Optional: /api/tts returns 500 if unset
ELEVENLABS_API_KEY=a

# Comma-separated origins for browser requests (default *)
# CORS_ORIGINS=http://localhost:3000,https://your-frontend.example.com
